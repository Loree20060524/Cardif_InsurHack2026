{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python scripts/build_vercel.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,tmp/**,data/**,research/**,docs/**,prototypes/**,assets/**,public/**,.git/**,.env*,regintel_*cache*.json,regintel_source_store*.json,regintel_event_history*.json,regintel_law_versions*.json}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api?__regintel_route=:path*"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]},
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
