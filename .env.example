# Reference only: server.py reads process environment variables, not this file.
# Local defaults remain 127.0.0.1:8082 and data files in the project directory.
REGINTEL_HOST=127.0.0.1
PORT=8082

# For a cloud deployment, use 0.0.0.0 and an attached persistent volume.
# REGINTEL_DATA_DIR=/app/data

# Vercel provides VERCEL=1 automatically and uses /tmp/regintel by default.
# /tmp is only a working cache; it does not preserve history across instances.
# With a Neon connection, the five data documents are saved in Postgres.
# Marketplace DATABASE_URL / POSTGRES_URL / POSTGRES_URL_NON_POOLING are detected.
# A locally saved file is not automatically loaded by server.py.
# REGINTEL_DATABASE_URL=postgresql://... (keep the real value out of Git)
# REGINTEL_STORAGE_NAMESPACE=regintel-v1

# Local runs use Ollama; Vercel defaults to the direct Gemini API.
# REGINTEL_AI_PROVIDER=gemini
# REGINTEL_AI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=... (set only in Vercel Production; do not commit the real key)
# Use a Google AI Studio project whose Billing Tier is Free Tier, without billing.
# Free quota is limited and content may be used to improve Google's products.
# REGINTEL_AI_TIMEOUT=180
# REGINTEL_AI_MAX_TOKENS=4096
# The app never enables billing, purchases credits, or switches to another model.
# Optional explicit provider: vercel_gateway uses Vercel request-scoped OIDC or
# AI_GATEWAY_API_KEY, and requires separate Gateway account verification/credits.
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=false
