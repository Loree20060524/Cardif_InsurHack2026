# Reference only: server.py reads process environment variables, not this file.
# Local defaults remain 127.0.0.1:8082 and data files in the project directory.
REGINTEL_HOST=127.0.0.1
PORT=8082

# For a cloud deployment, use 0.0.0.0 and an attached persistent volume.
# REGINTEL_DATA_DIR=/app/data

# Vercel provides VERCEL=1 automatically and uses /tmp/regintel by default.
# /tmp is only a working cache; it does not preserve history across instances.
# Persistent database integration is still required before a complete launch.

# A cloud host cannot use Ollama on your switched-off personal computer.
# Configure a model service running independently of your computer.
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=false
